<section class="guarantee">
  <div class="container">
    <div class="guarantee-grid">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.body }}</p>
        <div class="seals">
          {%- for block in section.blocks -%}
            <div class="seal" {{ block.shopify_attributes }}>
              <div class="num">{{ block.settings.number | escape }}</div>
              <div class="lbl">{{ block.settings.label | escape }}</div>
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.cta_text != blank -%}
          <div class="guarantee-cta">
            <a href="{{ section.settings.cta_url }}" class="btn btn-cream">{{ section.settings.cta_text | escape }}</a>
          </div>
        {%- endif -%}
      </div>
      <div class="guarantee-image"{% if section.settings.image != blank %} style="background-image:url('{{ section.settings.image | image_url: width: 1200 }}')"{% endif %}></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Velura · Guarantee",
  "tag": "section",
  "settings": [
    { "type": "text",         "id": "eyebrow",  "label": "Eyebrow", "default": "Our promise" },
    { "type": "richtext",     "id": "heading",  "label": "Heading", "default": "<p>Lifetime guarantee. <em>Highest quality material</em>.</p>" },
    { "type": "richtext",     "id": "body",     "label": "Body",    "default": "<p>We stand behind every Velura device for life. Built from medical-grade silicone with a fully waterproof IPX7 housing — designed to last.</p>" },
    { "type": "image_picker", "id": "image",    "label": "Image" },
    { "type": "text",         "id": "cta_text", "label": "CTA text", "default": "Shop the activator" },
    { "type": "url",          "id": "cta_url",  "label": "CTA URL" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "seal",
      "name": "Seal",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "∞" },
        { "type": "text", "id": "label",  "label": "Label",  "default": "Lifetime guarantee" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "seal", "settings": { "number": "∞",    "label": "Lifetime guarantee" } },
      { "type": "seal", "settings": { "number": "IPX7", "label": "Fully waterproof" } },
      { "type": "seal", "settings": { "number": "4",    "label": "Motor zones" } },
      { "type": "seal", "settings": { "number": "15k+", "label": "Happy customers" } }
    ]
  },
  "presets": [{ "name": "Velura · Guarantee" }]
}
{% endschema %}
