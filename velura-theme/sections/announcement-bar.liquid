{%- comment -%}
  Scrolling announcement bar.
{%- endcomment -%}

<div class="announce" aria-label="Promotions">
  <div class="announce-track" data-loop="true">
    {%- for block in section.blocks -%}
      <span><span class="dot"></span>{{ block.settings.text | escape }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "announcement-section",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "USE CODE: BLOOM15 FOR 15% OFF YOUR FIRST ORDER" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "USE CODE: BLOOM15 FOR 15% OFF YOUR FIRST ORDER" } },
      { "type": "message", "settings": { "text": "IPX7 WATERPROOF" } },
      { "type": "message", "settings": { "text": "MEDICAL-GRADE SILICONE" } },
      { "type": "message", "settings": { "text": "SUPPORTS PELVIC FLOOR HEALTH" } },
      { "type": "message", "settings": { "text": "FREE DISCREET SHIPPING" } },
      { "type": "message", "settings": { "text": "LIFETIME GUARANTEE" } }
    ]
  }
}
{% endschema %}
