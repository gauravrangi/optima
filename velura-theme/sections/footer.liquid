<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        {%- if section.settings.logo != blank -%}
          <div style="display:inline-block;background:var(--bg-cream);padding:14px 20px;border-radius:6px">
            <img src="{{ section.settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}" style="height:72px;width:auto;display:block" />
          </div>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="footer-blurb">{{ section.settings.tagline }}</p>
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h5>{{ block.settings.heading | escape }}</h5>
            <ul>
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="footer-bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal_note }}</span>
      <span>Privacy · Terms · Accessibility</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Footer logo" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Pelvic wellness, reimagined." },
    { "type": "text", "id": "legal_note", "label": "Legal note", "default": "Velura is a wellness product, not a medical device." }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Learn" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "menu", "settings": { "heading": "Company" } }
    ]
  }
}
{% endschema %}
