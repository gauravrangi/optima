<section class="science">
  <div class="container-narrow">
    <div class="science-head">
      <h2>Your addresses</h2>
    </div>
    {%- paginate customer.addresses by 10 -%}
      {%- for address in customer.addresses -%}
        <div style="padding:24px;border:1px solid var(--line);border-radius:4px;margin-bottom:16px;background:var(--bg-cream)">
          {%- if address == customer.default_address -%}<span class="eyebrow" style="margin-bottom:8px;display:block">Default</span>{%- endif -%}
          {{ address | format_address }}
        </div>
      {%- endfor -%}
      {%- if paginate.pages > 1 -%}<div style="margin-top:24px">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
