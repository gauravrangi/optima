<section class="science">
  <div class="container-narrow" style="max-width:480px">
    <div class="science-head">
      <h2>Log in</h2>
    </div>
    {%- form 'customer_login' -%}
      {%- if form.errors -%}<div style="color:var(--accent-deep);margin-bottom:16px">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label style="display:block;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;margin-bottom:8px">Email</label>
      <input type="email" name="customer[email]" required style="width:100%;padding:14px 16px;border:1px solid var(--line);border-radius:8px;font-family:inherit;margin-bottom:16px" />
      <label style="display:block;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;font-weight:600;margin-bottom:8px">Password</label>
      <input type="password" name="customer[password]" required style="width:100%;padding:14px 16px;border:1px solid var(--line);border-radius:8px;font-family:inherit;margin-bottom:24px" />
      <button type="submit" class="btn btn-primary" style="width:100%">Sign in</button>
      <p style="margin-top:20px;text-align:center;font-size:14px;color:var(--ink-soft)">
        <a href="{{ routes.account_recover_url }}" style="text-decoration:underline">Forgot password?</a> ·
        <a href="{{ routes.account_register_url }}" style="text-decoration:underline">Create account</a>
      </p>
    {%- endform -%}
  </div>
</section>
