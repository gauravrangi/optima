<section class="science">
  <div class="container">
    <div class="science-head">
      <h2>Collections</h2>
    </div>
    <div class="reviews-grid">
      {%- for c in collections -%}
        <a class="review" href="{{ c.url }}" style="text-decoration:none">
          {%- if c.image -%}
            <img src="{{ c.image | image_url: width: 800 }}" alt="{{ c.title | escape }}" style="border-radius:4px;margin-bottom:16px" />
          {%- endif -%}
          <h4>{{ c.title }}</h4>
          <p>{{ c.products_count }} product{% if c.products_count != 1 %}s{% endif %}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
